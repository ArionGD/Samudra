# Backend (Python / uv)
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/*.egg-info/
backend/.pytest_cache/
backend/.env

# Frontend (Node / Vite)
frontend/node_modules/
frontend/dist/
frontend/.env.local
frontend/.env.*.local

# Databases — never commit real participant data, even dev fixtures
database/dev/*.db
database/dev/*.db-journal
!database/dev/.gitkeep

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

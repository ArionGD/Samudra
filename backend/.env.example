# Copy to .env and fill in for your environment. .env is gitignored.

ENVIRONMENT=development

# Dev default: local SQLite files under database/dev/. Leave unset locally.
# Prod: point these at TWO SEPARATE Neon Postgres projects/instances.
# Never point both at the same database — see ARCHITECTURE.md #4.
# RESEARCH_DATABASE_URL=postgresql+psycopg://user:pass@host/research_db
# CONTACT_DATABASE_URL=postgresql+psycopg://user:pass@host/contact_db

ADMIN_API_KEY=change-me-to-a-real-secret

CORS_ORIGINS=["http://localhost:5173"]
